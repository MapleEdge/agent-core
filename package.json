{
  "name": "agent-core",
  "version": "0.1.0",
  "description": "Standalone memory and action service for an agent-aware development platform",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke_test.sh",
    "eval:llm": "tsx scripts/eval_llm.ts",
    "test:parity": "vitest run tests/parity/",
    "test:perf": "vitest run tests/performance/",
    "test:all": "vitest run",
    "parity-report": "tsx scripts/parity-report.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "better-sqlite3": "^11.9.1",
    "fastify": "^5.3.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  }
}
